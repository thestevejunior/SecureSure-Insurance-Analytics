      <aliases enabled='yes' />
      <column caption='Premium Attainment %' datatype='real' name='[Calculation_0733418019512320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([premium_target]) = 0 THEN&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    SUM([written_premium]) / SUM([premium_target])&#13;&#10;END' />
      </column>
      <column caption='Collection Rate %' datatype='real' name='[Calculation_0733418019762177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([premium_due]) = 0 THEN&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    SUM([premium_collected]) / SUM([premium_due])&#13;&#10;END' />
      </column>
      <column caption='Policy Attainment %' datatype='real' name='[Calculation_0733418019868674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([policy_target]) = 0 THEN&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    SUM([new_policy_count]) / SUM([policy_target])&#13;&#10;END' />
      </column>
