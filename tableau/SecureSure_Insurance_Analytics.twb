      <column caption='Claims Reported' datatype='integer' name='[Calculation_1032211008421888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([claim_id])' />
      </column>
      <column caption='Open Claims' datatype='integer' name='[Calculation_1032211010801665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [operational_status] = &quot;Open&quot;&#13;&#10;    THEN [claim_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='High-Priority Claims' datatype='integer' name='[Calculation_1032211037339650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [requires_fraud_review]&#13;&#10;    THEN [claim_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Average Settlement Days' datatype='real' name='[Calculation_1032211037798403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([settlement_days])' />
      </column>
      <column caption='SLA Breaches' datatype='integer' name='[Calculation_1032211037917188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [sla_status] = &quot;SLA Breached&quot;&#13;&#10;    THEN [claim_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='SLA Compliance %' datatype='real' name='[Calculation_1032211038027781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#13;&#10;    COUNTD(&#13;&#10;        IF [sla_status] = &quot;Within SLA&quot;&#13;&#10;            OR [sla_status] = &quot;SLA Breached&quot;&#13;&#10;        THEN [claim_id]&#13;&#10;        END&#13;&#10;    ) = 0&#13;&#10;THEN 0&#13;&#10;ELSE&#13;&#10;    COUNTD(&#13;&#10;        IF [sla_status] = &quot;Within SLA&quot;&#13;&#10;        THEN [claim_id]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    COUNTD(&#13;&#10;        IF [sla_status] = &quot;Within SLA&quot;&#13;&#10;            OR [sla_status] = &quot;SLA Breached&quot;&#13;&#10;        THEN [claim_id]&#13;&#10;        END&#13;&#10;    )&#13;&#10;END' />
      </column>
